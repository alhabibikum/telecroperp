# =========================================================================
# TELECORP ERP - ENVIRONMENT CONFIGURATION
# =========================================================================

# Supabase Cloud Database Configuration
# Copy to .env.local — never commit real keys.
# https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# One-time migration only. Keep the service-role key server-side; never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/

# Optional one-time setup for an empty database. Remove these after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Application Port (Default: 3000)
PORT=3000
