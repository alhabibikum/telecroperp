{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TeleCorp ERP",
  "version": "1.0.1",
  "identifier": "com.telecorp.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeleCorp ERP - Multi-Brand Smartphone Dealer & Distribution",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5NEE1RjZGQTE1OEFBMTEKUldRUnFsaWhiMTlLQ2U4STI0NUlpdzhqZkFTKzRtSVlCdVpRV2hVdForWU1yNlJqd21KNmtrdmoK",
      "endpoints": [
        "https://github.com/alhabibikum/telecroperp/releases/latest/download/latest.json"
      ]
    }
  }
}